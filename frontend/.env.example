# HireSense AI frontend environment template
# Copy this file to `frontend/.env` for local frontend-only configuration.

# Local demo auth
# Keep true for hackathon demos without Firebase web auth.
VITE_DEMO_AUTH_ENABLED=true

# Supabase Web App config
# Required only when using real Supabase Authentication from the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
