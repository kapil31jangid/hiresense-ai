# HireSense AI frontend environment template
# Copy this file to `frontend/.env` for local frontend-only configuration.

# Local demo auth
# Keep true for hackathon demos without Firebase web auth.
VITE_DEMO_AUTH_ENABLED=true

# Firebase Web App config
# Required only when using real Firebase Authentication from the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
