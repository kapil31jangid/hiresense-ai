# HireSense AI environment template
# Copy this file to `.env` for local development and fill in real values.
# The current prototype uses safe defaults for most settings, so these are optional
# until the team wires persistent storage, external LLMs, or object storage.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=HireSense AI
GOOGLE_CLOUD_PROJECT=

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI providers
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CLOUD_REGION=asia-south1
GEMINI_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_SERVICE_ACCOUNT_JSON=

# Semantic search
FAISS_INDEX_DIR=backend/data/faiss

# Object storage
# Primary: Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET_NAME=hiresense-ai
GCS_CREDENTIALS_JSON=
GCS_REGION=asia-south1
GCS_EMULATOR_HOST=

# Cloud Run / deployment
CLOUD_RUN_SERVICE_NAME=hiresense-ai
CLOUD_RUN_REGION=asia-south1
