# HireSense AI environment template
# Copy this file to `.env` and fill in the cloud project values for your deployment.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=HireSense AI
DEMO_AUTH_ENABLED=true

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend local demo mode
VITE_DEMO_AUTH_ENABLED=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI providers
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CLOUD_REGION=asia-south1
GEMINI_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
AI_PROVIDER_MODE=gemini

# Supabase (Backend Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Semantic search
FAISS_INDEX_DIR=backend/data/faiss


# Cloud Run / deployment
CLOUD_RUN_SERVICE_NAME=hiresense-ai
CLOUD_RUN_REGION=asia-south1

# Challenge dataset defaults
CHALLENGE_DATASET_DIR="backend/data/challenge"
CHALLENGE_CANDIDATES_PATH="backend/data/challenge/candidates.jsonl.gz"
CHALLENGE_SAMPLE_CANDIDATES_PATH="backend/data/challenge/sample_candidates.json"
CHALLENGE_SCHEMA_PATH="backend/data/challenge/candidate_schema.json"
CHALLENGE_SAMPLE_SUBMISSION_PATH="backend/data/challenge/sample_submission.csv"
CHALLENGE_INDEX_PATH=backend/data/challenge/candidate_index.json
CHALLENGE_CALIBRATION_PATH=backend/data/challenge/sample_calibration.json
CHALLENGE_SUBMISSION_OUTPUT_PATH=backend/exports/official_submission.csv
CHALLENGE_DATASET_AUTOLOAD=true

