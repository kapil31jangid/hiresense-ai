# HireSense AI environment template
# Copy this file to `.env` and fill in the cloud project values for your deployment.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=HireSense AI
GOOGLE_CLOUD_PROJECT=
DEMO_AUTH_ENABLED=true
USE_APPLICATION_DEFAULT_CREDENTIALS=false

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend local demo mode
VITE_DEMO_AUTH_ENABLED=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI providers
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CLOUD_REGION=asia-south1
GEMINI_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
AI_PROVIDER_MODE=gemini

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Semantic search
FAISS_INDEX_DIR=backend/data/faiss

# Object storage
# Primary: Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET_NAME=hiresense-ai
GCS_CREDENTIALS_JSON=
GCS_REGION=asia-south1

# Cloud Run / deployment
CLOUD_RUN_SERVICE_NAME=hiresense-ai
CLOUD_RUN_REGION=asia-south1

# Challenge dataset defaults
# Keep the large organizer dataset outside git and point the project to it locally.
CHALLENGE_DATASET_DIR=
CHALLENGE_CANDIDATES_PATH=
CHALLENGE_SAMPLE_CANDIDATES_PATH=
CHALLENGE_SCHEMA_PATH=
CHALLENGE_SAMPLE_SUBMISSION_PATH=
CHALLENGE_INDEX_PATH=backend/data/challenge/candidate_index.json
CHALLENGE_CALIBRATION_PATH=backend/data/challenge/sample_calibration.json
CHALLENGE_SUBMISSION_OUTPUT_PATH=backend/exports/official_submission.csv
CHALLENGE_DATASET_AUTOLOAD=false
